<div class="d-flex justify-content-end mb-2">
  <div class="meal-plan-assistant-user-message"><%= turn.user_message %></div>
</div>

<div class="mb-3">
  <p class="mb-2"><%= turn.message %></p>

  <% turn.suggestions.each do |suggestion| %>
    <% recipe = suggestion.recipe %>
    <div class="card mb-2 meal-plan-assistant-suggestion">
      <div class="card-body d-flex justify-content-between align-items-start gap-2 py-2">
        <div>
          <h6 class="mb-1"><%= link_to recipe.title, recipe %></h6>
          <div class="small text-muted">
            <%= recipe.last_prepared_on ? "Last made #{time_ago_in_words(recipe.last_prepared_on)} ago" : 'Never made' %>
            &middot; serves <%= recipe.servings %>
            &middot; <%= recipe.prep_time.to_i + recipe.cook_time.to_i %> min
          </div>
          <div class="small"><%= suggestion.reason %></div>
        </div>
        <%= button_to '+ Add', meal_plan_assistant_recipes_path,
                      params: { recipe_id: recipe.id },
                      class: 'btn btn-sm btn-outline-primary text-nowrap',
                      data: { meal_plan_assistant_target: 'addButton', recipe_id: recipe.id } %>
      </div>
    </div>
  <% end %>
</div>
