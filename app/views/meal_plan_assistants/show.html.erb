<% content_for(:title, 'Plan with Claude') %>

<div data-controller="meal-plan-assistant"
     data-meal-plan-assistant-new-plan-url-value="<%= new_meal_plan_path %>">
  <p><%= link_to MaterialIcon.new(icon: :arrow_left).render + 'Meal Plans', meal_plans_path %></p>

  <h1>Plan with Claude</h1>

  <p class="text-muted">
    Planning for <strong><%= l @prep_day, format: :month_as_text %></strong>.
    <% if @overdue_recipes.any? %>
      Haven't had in a while:
      <%= safe_join(@overdue_recipes.map { |recipe| "#{recipe.title} (#{time_ago_in_words(recipe.last_prepared_on)} ago)" }, ', ') %>.
    <% end %>
  </p>

  <div class="card mb-3 meal-plan-assistant-tray">
    <div class="card-body">
      <h5 class="card-title">
        This week
        <small class="text-muted" data-meal-plan-assistant-target="trayCount"></small>
      </h5>
      <p class="card-text text-muted mb-0" data-meal-plan-assistant-target="trayEmpty">
        Tap <strong>+ Add</strong> on a suggestion to keep it for this week.
      </p>
      <ul class="list-group list-group-flush mb-2" data-meal-plan-assistant-target="trayList"></ul>
      <a href="<%= new_meal_plan_path %>" class="btn btn-primary hidden" data-meal-plan-assistant-target="createLink">
        Create meal plan
      </a>
    </div>
  </div>

  <div id="assistant_conversation" data-meal-plan-assistant-target="conversation"></div>

  <p class="text-muted hidden" data-meal-plan-assistant-target="thinking">
    <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
    Claude is thinking&hellip;
  </p>

  <%= form_with url: meal_plan_assistant_path,
                data: {
                  meal_plan_assistant_target: 'form',
                  action: 'turbo:submit-start->meal-plan-assistant#submitStart turbo:submit-end->meal-plan-assistant#submitEnd'
                } do |form| %>
    <%= hidden_field_tag :history, '[]', id: 'assistant_history' %>
    <div data-meal-plan-assistant-target="trayInputs"></div>

    <div class="d-flex flex-wrap gap-2 mb-2">
      <% @starters.each do |starter| %>
        <%= button_tag starter, type: 'submit', name: 'starter', value: starter, class: 'btn btn-sm btn-outline-secondary' %>
      <% end %>
    </div>

    <div class="input-group">
      <%= form.text_area :message,
                         rows: 2,
                         class: 'form-control',
                         placeholder: "…or tell me what you're in the mood for",
                         data: {
                           meal_plan_assistant_target: 'message',
                           action: 'keydown.enter->meal-plan-assistant#submitOnEnter'
                         } %>
      <%= form.submit 'Ask', class: 'btn btn-primary' %>
    </div>
  <% end %>
</div>
