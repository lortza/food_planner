<div class="mb-3">
  <p class="mb-2"><%= reply.message %></p>

  <% reply.suggestions.each do |suggestion| %>
    <% recipe = suggestion.recipe %>
    <div class="card mb-2">
      <div class="card-body d-flex justify-content-between align-items-start gap-2 py-2">
        <div>
          <h6 class="mb-1"><%= link_to recipe.title, recipe, target: '_blank', rel: 'noopener' %></h6>
          <div class="small text-muted">
            <%= recipe.last_prepared_on ? "Last made #{time_ago_in_words(recipe.last_prepared_on)} ago" : 'Never made' %>
            &middot; serves <%= recipe.servings %>
            &middot; <%= recipe.prep_time.to_i + recipe.cook_time.to_i %> min
          </div>
          <div class="small"><%= suggestion.reason %></div>
        </div>
        <button type="button"
                class="btn btn-sm btn-outline-primary text-nowrap"
                data-meal-plan-assistant-target="addButton"
                data-action="meal-plan-assistant#add"
                data-meal-plan-assistant-id-param="<%= recipe.id %>"
                data-meal-plan-assistant-title-param="<%= recipe.title %>"
                data-meal-plan-assistant-servings-param="<%= recipe.servings %>">
          + Add
        </button>
      </div>
    </div>
  <% end %>
</div>
