<%= turbo_stream.append 'assistant_conversation' do %>
  <% if @turn %>
    <%= render 'turn', turn: @turn %>
  <% else %>
    <% if @user_message.present? %>
      <div class="d-flex justify-content-end mb-2">
        <div class="meal-plan-assistant-user-message"><%= @user_message %></div>
      </div>
    <% end %>
    <div class="alert alert-warning mb-3"><%= @error %></div>
  <% end %>
<% end %>
